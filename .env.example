# AI Companion API Keys & Configuration — TEMPLATE
# Copy this file to `.env` (gitignored) and fill in your real keys.
# NEVER commit `.env`: real keys stay local and are pushed to the device
# Keystore with `python3 send.py --sync-keys`.

# Round-robin: comma-separated keys per provider. The provider registry tries
# keys in order and rotates to the next one on 429/failure.
GEMINI_API_KEYS=
OPENAI_API_KEYS=
OPENROUTER_API_KEYS=
GROQ_API_KEYS=

# Provider preference order and default model.
AI_PROVIDER_ORDER=gemini,openai,openrouter,groq
AI_MODEL_DEFAULT=gpt-4o-mini

# Proactive observation cadence.
OBSERVATION_INTERVAL_MINUTES=30
